# developer.riotgames.com のダッシュボードで発行したキーを貼る（24時間で失効）
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# 自分の Riot ID（名前#タグ）
RIOT_ID=Name#JP1
PLATFORM=jp1
REGION=asia
# 録画の保存フォルダ（clip コマンドで自動で録画を探す。空なら --video で指定）
VIDEO_DIR=
# 録画設定（record コマンド）
# RECORD_MONITOR=0   録画するモニター番号（0 = メイン）
# RECORD_FPS=30
# RECORD_QUALITY=30  小さいほど高画質・大きいファイル
# RECORD_KEEP=30     recordings/ に残す録画の数（古いものから自動削除。0 = 削除しない）
